. * Helper program: one-tailed two-prop test, returns formatted cell
. capture program drop calc_cell

. program define calc_cell, rclass
  1.     args promise_col outcome
  2.     quietly count if `promise_col' == 1
  3.     local n_p  = r(N)
  4.     quietly count if `promise_col' == 0
  5.     local n_np = r(N)
  6.     quietly count if `promise_col' == 1 & `outcome' == 1
  7.     local x_p  = r(N)
  8.     quietly count if `promise_col' == 0 & `outcome' == 1
  9.     local x_np = r(N)
 10.     local p1 = `x_p' / `n_p'
 11.     local p2 = `x_np' / `n_np'
 12.     local pp = (`x_p' + `x_np') / (`n_p' + `n_np')
 13.     local se = sqrt(`pp' * (1 - `pp') * (1/`n_p' + 1/`n_np'))
 14.     if `se' > 0  local z = (`p1' - `p2') / `se'
 15.     else         local z = 0
 16.     local pval = 1 - normal(`z')
 17.     return scalar diff = `p1' - `p2'
 18.     return scalar pval = `pval'
 19.     local pct1 = round(`p1' * 100)
 20.     local pct2 = round(`p2' * 100)
 21.     return local prop "`pct1'\% vs.\ `pct2'\%"
 22. end

. 
