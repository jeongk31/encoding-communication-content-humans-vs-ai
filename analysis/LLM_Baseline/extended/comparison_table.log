. capture program drop get_coef

. program define get_coef, rclass
  1.     args bmat vmat ivname
  2.     local i = colnumb(`bmat', "`ivname'")
  3.     local b = `bmat'[1, `i']
  4.     local v = `vmat'[`i', `i']
  5.     local se = sqrt(`v')
  6.     local z  = `b' / `se'
  7.     local pval = 2 * normal(-abs(`z'))
  8.     return scalar coef = `b'
  9.     return scalar pval = `pval'
 10.     local bf : display %6.3f `b'
 11.     if `pval' < 0.001 {
 12.         return local cell "`bf' (\(p{<}0.001\))"
 13.     }
 14.     else {
 15.         local pf : display %5.3f `pval'
 16.         return local cell "`bf' (\(p=`pf'\))"
 17.     }
 18. end

