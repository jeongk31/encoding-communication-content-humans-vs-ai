  5.     if "`iv_suffix'" == "all_way_split_voter"     local ivlabel "3-Way Spl
> it \(\times\) Voter"
  6.     if "`iv_suffix'" == "compete_proposer"        local ivlabel "Competiti
> on \(\times\) Proposer"
  7.     if "`iv_suffix'" == "compete_voter"           local ivlabel "Competiti
> on \(\times\) Voter"
  8.     if "`iv_suffix'" == "future_coalition_voter"  local ivlabel "Future Co
> alition \(\times\) Voter"
  9. 
.     get_coef_t Bo Vo `df_o' ho_`iv_suffix'
 10.     local o_coef = r(coef)
 11.     local o_pval = r(pval)
 12.     coefcell `o_coef'
 13.     local o_ccell "`r(cell)'"
 14.     pcell `o_pval'
 15.     local o_pcell "`r(cell)'"
 16. 
.     get_coef_t Bn Vn `df_n' hn_`iv_suffix'
 17.     local n_coef = r(coef)
 18.     local n_pval = r(pval)
 19.     coefcell `n_coef'
 20.     local n_ccell "`r(cell)'"
 21.     pcell `n_pval'
 22.     local n_pcell "`r(cell)'"
 23. 
.     get_coef_t Bl Vl `df_l' l_`iv_suffix'
 24.     local l_coef = r(coef)
 25.     local l_pval = r(pval)
 26.     coefcell `l_coef'
 27.     local l_ccell "`r(cell)'"
 28.     pcell `l_pval'
