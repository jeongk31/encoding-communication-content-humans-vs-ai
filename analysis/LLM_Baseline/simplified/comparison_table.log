. * ===========================================================================
. * HELPER PROGRAMS
. * ===========================================================================
. capture program drop pcellD

. program define pcellD, rclass
  1.     args pval
  2.     if `pval' < 0.001 {
  3.         return local cell "\(p{<}0.001\)"
  4.     }
  5.     else {
  6.         local pf : display %5.3f `pval'
  7.         return local cell "\(p=`pf'\)"
  8.     }
  9. end

. 
. capture program drop ynsign

. program define ynsign, rclass
  1.     args a b
  2.     if (`a' > 0 & `b' > 0) | (`a' < 0 & `b' < 0) return local yn "Yes"
  3.     else                                          return local yn "No"
  4. end

. 
. capture program drop ynsig

. program define ynsig, rclass
  1.     args p1 p2 cut
  2.     local s1 = (`p1' < `cut')
  3.     local s2 = (`p2' < `cut')
  4.     if `s1' == `s2' return local yn "Yes"
  5.     else            return local yn "No"
  6. end

. 
. capture program drop get_coef

. program define get_coef, rclass
  1.     args bmat vmat ivname
  2.     local i = colnumb(`bmat', "`ivname'")
  3.     local b = `bmat'[1, `i']
  4.     local se = sqrt(`vmat'[`i', `i'])
  5.     local pval = 2 * normal(-abs(`b'/`se'))
  6.     return scalar coef = `b'
  7.     return scalar pval = `pval'
  8. end

. 
. capture program drop get_coef_t

. program define get_coef_t, rclass
  1.     args bmat vmat df ivname
  2.     local i = colnumb(`bmat', "`ivname'")
  3.     local b = `bmat'[1, `i']
  4.     local se = sqrt(`vmat'[`i', `i'])
  5.     local pval = 2 * ttail(`df', abs(`b'/`se'))
  6.     return scalar coef = `b'
  7.     return scalar pval = `pval'
  8. end

. 
. capture program drop calc_cell

. program define calc_cell, rclass
  1.     args promise_col outcome
  2.     quietly count if `promise_col' == 1
  3.     local n_p  = r(N)
  4.     quietly count if `promise_col' == 0
  5.     local n_np = r(N)
  6.     quietly count if `promise_col' == 1 & `outcome' == 1
  7.     local x_p  = r(N)
  8.     quietly count if `promise_col' == 0 & `outcome' == 1
  9.     local x_np = r(N)
 10.     local p1 = `x_p' / `n_p'
 11.     local p2 = `x_np' / `n_np'
 12.     local pp = (`x_p' + `x_np') / (`n_p' + `n_np')
 13.     local se = sqrt(`pp' * (1 - `pp') * (1/`n_p' + 1/`n_np'))
 14.     if `se' > 0  local z = (`p1' - `p2') / `se'
 15.     else         local z = 0
 16.     return scalar diff = `p1' - `p2'
 17.     return scalar pval = 1 - normal(`z')
 18. end

. 
. capture program drop writerow

. program define writerow
  1.     args fh label o_p n_p l_p o_c n_c l_c cut
  2.     pcellD `o_p'
  3.     local op "`r(cell)'"
  4.     pcellD `n_p'
  5.     local np "`r(cell)'"
  6.     pcellD `l_p'
  7.     local lp "`r(cell)'"
  8.     ynsign `o_c' `n_c'
  9.     local sgnOR "`r(yn)'"
 10.     ynsign `n_c' `l_c'
 11.     local sgnRL "`r(yn)'"
 12.     ynsig `o_p' `n_p' `cut'
 13.     local sigOR "`r(yn)'"
 14.     ynsig `n_p' `l_p' `cut'
 15.     local sigRL "`r(yn)'"
 16.     file write `fh' "`label' & `op' & `np' & `lp' & `sgnOR' & `sgnRL' & `s
> igOR' & `sigRL' \\" _n
 17. end

