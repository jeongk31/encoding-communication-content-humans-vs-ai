 10.     * Override Original RA Proportion with paper's exact Table III pooled 
> values
.     * (only 30/48=0.625 rounds differently: paper 62%, Stata default 63%).
.     if "`outcome'" == "a_in"   local o_prop "79\% vs.\ 37\%"
 11.     if "`outcome'" == "b_roll" local o_prop "79\% vs.\ 33\%"
 12.     if "`outcome'" == "inroll" local o_prop "62\% vs.\ 14\%"
 13. 
.     calc_cell new_promise `outcome'
 14.     local n_prop "`r(prop)'"
 15.     local n_diff = r(diff)
 16.     local n_pval = r(pval)
 17.     pcell `n_pval'
 18.     local n_pcell "`r(cell)'"
 19. 
.     calc_cell llm_promise `outcome'
 20.     local l_prop "`r(prop)'"
 21.     local l_diff = r(diff)
 22.     local l_pval = r(pval)
 23.     pcell `l_pval'
 24.     local l_pcell "`r(cell)'"
